---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'Cisco IT · Logisim — Investigación',
  description = 'Sitio educativo de investigación sobre Cisco IT Essentials Virtual Desktop y Logisim Evolution.',
  current = 'home',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav current={current} />
    <main>
      <slot />
    </main>
    <Footer />

    <audio id="ui-sound" src={`${import.meta.env.BASE_URL}/audio/ui-sound.mp3`} preload="auto" aria-hidden="true"></audio>

    <script is:inline>
      // ── Video lifecycle: pause when off-screen, play when visible ──────────
      (function () {
        const IO = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              const v = e.target;
              if (e.isIntersecting) { v.play().catch(() => {}); }
              else                  { v.pause(); }
            });
          },
          { threshold: 0.1 }
        );
        document.querySelectorAll('video[autoplay]').forEach((v) => IO.observe(v));
      })();

      // ── Sonido UI global: feedback corto y discreto para controles accionables.
      const uiAudio = document.querySelector('#ui-sound');
      const uiSelector = 'a, button, summary, [role="button"]';

      function isEnabledControl(target) {
        return target && !target.hasAttribute('disabled') && target.getAttribute('aria-disabled') !== 'true';
      }

      function playUiSound() {
        if (!uiAudio) return;
        uiAudio.volume = 0.42;
        uiAudio.currentTime = 0;
        uiAudio.play().catch(() => {});
      }

      // Pointerdown inicia el sonido antes de que un enlace cambie de página.
      document.addEventListener('pointerdown', (event) => {
        const target = event.target instanceof Element ? event.target.closest(uiSelector) : null;
        if (isEnabledControl(target)) playUiSound();
      }, { passive: true });

      // Los controles activados con teclado generan click con detail === 0.
      document.addEventListener('click', (event) => {
        if (event.detail !== 0) return;
        const target = event.target instanceof Element ? event.target.closest(uiSelector) : null;
        if (isEnabledControl(target)) playUiSound();
      }, { passive: true });
    </script>
  </body>
</html>
